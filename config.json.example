{
  "workflow": {
    "autoEnter": false
  },
  "models": {
    "explore": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "thinking": "medium"
    },
    "plan": {
      "provider": "anthropic",
      "model": "claude-opus-4-5",
      "thinking": "high",
      "contextWindow": 150000
    },
    "planReview": {
      "provider": "openai",
      "model": "gpt-5.1",
      "thinking": "high"
    },
    "review": {
      "provider": "openai",
      "model": "gpt-5.1",
      "thinking": "high"
    },
    "qa": {
      "provider": "openai",
      "model": "gpt-5.1",
      "thinking": "high"
    },
    "work": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "thinking": "medium"
    },
    "commit": {
      "provider": "openai",
      "model": "gpt-5.1-mini",
      "thinking": "low"
    }
  },
  "planReview": {
    "enabled": true
  },
  "review": {
    "enabled": true,
    "timeoutSeconds": 1800
  },
  "qa": {
    "enabled": true,
    "timeoutSeconds": 3600
  },
  "codeReview": {
    "enabled": true
  }
}